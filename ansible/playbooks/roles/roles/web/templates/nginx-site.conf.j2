server {
    listen {{ nginx_http_port }};
    listen [::]:{{ nginx_http_port }};
    server_name {{ inventory_hostname }}.{{ dns_domain }};
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen {{ nginx_https_port }} ssl http2;
    listen [::]:{{ nginx_https_port }} ssl http2;
    server_name {{ inventory_hostname }}.{{ dns_domain }};

    # SSL Configuration
    ssl_certificate /etc/nginx/ssl/{{ inventory_hostname }}.crt;
    ssl_certificate_key /etc/nginx/ssl/{{ inventory_hostname }}.key;
    
    # SSL Security Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Document Root
    root {{ nginx_document_root }};
    index index.html index.htm;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Logging
    access_log /var/log/nginx/{{ inventory_hostname }}_access.log;
    error_log /var/log/nginx/{{ inventory_hostname }}_error.log;

    location / {
        try_files $uri $uri/ =404;
    }

    # Hide Nginx version
    server_tokens off;
}
