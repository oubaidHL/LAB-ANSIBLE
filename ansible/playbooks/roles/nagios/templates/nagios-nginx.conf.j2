server {
    listen 80;
    listen [::]:80;
    server_name {{ nagios_server }};
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ nagios_server }};

    # SSL Configuration
    ssl_certificate /etc/nginx/ssl/nagios.crt;
    ssl_certificate_key /etc/nginx/ssl/nagios.key;
    
    # SSL Security Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Logging
    access_log /var/log/nginx/nagios_access.log;
    error_log /var/log/nginx/nagios_error.log;

    # Root directory for Nagios
    root /usr/share/nagios4/htdocs;
    index index.php index.html;

    # Authentication for Nagios
    auth_basic "Nagios Access - {{ env }}";
    auth_basic_user_file /etc/nagios4/htpasswd.users;

    location / {
        try_files $uri $uri/ =404;
    }

    # CGI Scripts
    location ~ \.cgi$ {
        root /usr/lib/cgi-bin/nagios4;
        include fastcgi_params;
        fastcgi_param AUTH_USER $remote_user;
        fastcgi_param REMOTE_USER $remote_user;
        fastcgi_param SCRIPT_FILENAME /usr/lib/cgi-bin/nagios4$fastcgi_script_name;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
    }

    location /nagios4 {
        alias /usr/share/nagios4/htdocs;
    }

    location /nagios4/cgi-bin {
        alias /usr/lib/cgi-bin/nagios4;
        include fastcgi_params;
        fastcgi_param AUTH_USER $remote_user;
        fastcgi_param REMOTE_USER $remote_user;
        fastcgi_param SCRIPT_FILENAME /usr/lib/cgi-bin/nagios4$fastcgi_script_name;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
    }

    # Hide Nginx version
    server_tokens off;
}
